# Dashboard login (defaults: admin / airscrobble)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=airscrobble

# Flask session secret — change to a random string
FLASK_SECRET_KEY=change-me-to-something-random

# Everything below is optional — you can configure these
# via the web dashboard instead of editing this file.
#
# LASTFM_API_KEY=
# LASTFM_USERNAME=
# SPOTIFY_EMAIL=
# SPOTIFY_PASSWORD=
# POLL_INTERVAL_SECONDS=10
